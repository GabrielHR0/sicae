# Copy to .env and fill values for local development.
# Do NOT commit .env with secrets.

# PostgreSQL connection (optional if using DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=

# Per-environment database names (optional)
SICAE_DATABASE_NAME=sicae_development
SICAE_DATABASE_USERNAME=
SICAE_DATABASE_PASSWORD=
SICAE_DATABASE_HOST=
SICAE_DATABASE_PORT=


# Rails
RAILS_ENV=development
# You can set SECRET_KEY_BASE for local development if needed
SECRET_KEY_BASE=
MAILER_SENDER=
