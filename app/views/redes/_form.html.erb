<%= form_with(model: rede, class: "contents") do |form| %>
  <% if rede.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(rede.errors.count, "error") %> prohibited this rede from being saved:</h2>

      <ul class="list-disc ml-6">
        <% rede.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :nome %>
    <%= form.text_field :nome, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": rede.errors[:nome].none?, "border-red-400 focus:outline-red-600": rede.errors[:nome].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :slug %>
    <%= form.text_field :slug, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": rede.errors[:slug].none?, "border-red-400 focus:outline-red-600": rede.errors[:slug].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :descricao %>
    <%= form.textarea :descricao, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": rede.errors[:descricao].none?, "border-red-400 focus:outline-red-600": rede.errors[:descricao].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :metadata %>
    <%= form.text_field :metadata, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": rede.errors[:metadata].none?, "border-red-400 focus:outline-red-600": rede.errors[:metadata].any?}] %>
  </div>

  <div class="my-5 flex items-center gap-2">
    <%= form.label :ativo %>
    <%= form.checkbox :ativo, class: ["block shadow-sm rounded-md border order-first h-5 w-5", {"border-gray-400 focus:outline-blue-600": rede.errors[:ativo].none?, "border-red-400 focus:outline-red-600": rede.errors[:ativo].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
