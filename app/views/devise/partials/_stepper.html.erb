<% current_value = local_assigns.fetch(:current, 0) %>
<nav class="stepper font-sans relative" aria-label="Progresso" data-controller="stepper" data-stepper-current-value="<%= current_value %>">
    <ol class="flex items-center w-full gap-4 mb-6">
        <% steps.each_with_index do |step, index| %>
            <% active = (index == current_value) %>
            <% status = index < current_value ? 'completed' : (active ? 'current' : 'upcoming') %>

            <% if index == steps.size - 1 %>
                <% after_classes = '' %>
            <% else %>
                <% after_color = index < current_value ? 'after:border-ruby-500 dark:after:border-ruby-500' : 'after:border-gray-300 dark:after:border-gray-600' %>
                <% after_classes = "after:content-[''] after:flex-1 after:block after:h-1 after:border-b after:border-4 after:ms-4 after:rounded-full ".concat(after_color) %>
            <% end %>

            <li class="flex w-full items-center <%= after_classes %>">
                <div class="flex items-center gap-3">
                    <span class="flex items-center justify-center w-10 h-10 lg:w-12 lg:h-12 rounded-full border-2 text-sm font-medium <%= (index == current_value) ? 'border-ruby-500 bg-ruby-500 text-white dark:border-ruby-500 dark:bg-ruby-500' : 'border-gray-300 bg-white text-gray-600 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-300' %>">
                        <% if step[:icon_html].present? %>
                            <%= raw(step[:icon_html].to_s.gsub(/<svg\b/, '<svg class="w-5 h-5"')) %>
                        <% else %>
                            <span class="w-5 h-5 flex items-center justify-center"><%= index + 1 %></span>
                        <% end %>
                    </span>
                </div>
            </li>
        <% end %>
    </ol>

    <div>
        <% steps.each_with_index do |step, index| %>
            <div class="step-content <%= 'hidden' unless index == current_value %>" data-step-index="<%= index %>">
                <header class="mb-4 flex items-center justify-start gap-3 text-gray-900 dark:text-white">
                    <% if step[:icon_html].present? %>
                        <div class="flex items-center justify-center w-8 h-8 rounded-full bg-ruby-100 text-ruby-600 dark:bg-ruby-900 dark:text-ruby-300">
                            <%= step[:icon_html].html_safe %>
                        </div>
                    <% end %>
                    <h3 class="text-lg font-semibold leading-tight"><%= step[:name] %></h3>
                </header>

                <div class="step-body">
                    <%= step[:body_html].to_s.html_safe %>
                </div>
                <footer class="mt-4 flex items-center justify-end gap-2">
                    <div class="mt-6 flex items-center justify-between">
                        <button type="button" data-action="click->stepper#prev" aria-label="Voltar" class="inline-flex items-center justify-center rounded-full p-2.5 bg-white border border-gray-300 hover:bg-gray-50 dark:bg-gray-800 dark:border-gray-600 dark:hover:bg-gray-700 transition-colors text-gray-700 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-ruby-500 dark:focus:ring-ruby-500 z-10">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                        </button>

                        <button type="button" data-action="click->stepper#next" aria-label="Próximo" class="inline-flex items-center justify-center rounded-full p-2.5 bg-white border border-gray-300 hover:bg-gray-50 dark:bg-gray-800 dark:border-gray-600 dark:hover:bg-gray-700 transition-colors text-gray-700 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-ruby-500 dark:focus:ring-ruby-500 z-10">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                        </button>
                    </div>
                </footer>
            </div>
        <% end %>
    </div>
</nav>