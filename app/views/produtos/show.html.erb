<% content_for :title, "Produto" %>

<%= render layout: "layouts/admin" do %>
  <div class="space-y-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-white"><%= @produto.nome %></h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Detalhes do produto selecionado.</p>
      </div>

      <div class="flex items-center gap-2">
        <%= link_to "Editar", edit_produto_path(@produto), class: "rounded-lg bg-gradient-to-br from-red-700 to-red-900 px-4 py-2 text-sm font-medium text-white hover:bg-gradient-to-br from-red-700 to-red-900" %>
        <%= link_to "Voltar", produtos_path, class: "rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800" %>
      </div>
    </div>

    <%= render "produtos/details", produto: @produto %>
  </div>
<% end %>
