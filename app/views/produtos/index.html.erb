<% content_for :title, "Produtos" %>
<% columns = [
  { key: :nome, label: "Nome", sortable: true, row_header: true, width: "30%" },
  {
    key: :categoria,
    label: "Categoria",
    sortable: true,
    width: "18%",
    render: ->(record, _view) { record.categoria&.nome || record[:categoria].presence || "-" }
  },
  { key: :estoque, label: "Estoque", sortable: true, width: "12%" },
  {
    key: :preco,
    label: "Preço",
    sortable: true,
    width: "14%",
    render: ->(record, view) { view.number_to_currency(record.preco) }
  },
  {
    key: :status,
    label: "Status",
    width: "10%",
    render: ->(record, view) do
      badge_class = "ml-auto inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium"

      if record.disponivel?
        view.tag.span(
          "Disponível",
          class: "#{badge_class} bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-200"
        )
      elsif record.ativo?
        view.tag.span(
          "Sem estoque",
          class: "#{badge_class} bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-200"
        )
      else
        view.tag.span(
          "Inativo",
          class: "#{badge_class} bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200"
        )
      end
    end
  },
  {
    key: :actions,
    label: "Ações",
    width: "16%",
    actions: true
  }
] %>

<% cards = [
  {
    title: "Total de produtos",
    value: Produto.count,
    description: "Quantidade de registros cadastrados",
    icon: icon_svg("box")
  },
  {
    title: "Produtos ativos",
    value: Produto.where(ativo: true).count,
    description: "Itens disponíveis no catálogo",
    icon: icon_svg("check")
  },
  {
    title: "Sem estoque",
    value: Produto.where(estoque: 0).count,
    description: "Produtos que precisam reposição",
    icon: icon_svg("alert")
  },
  {
    title: "Categorias usadas",
    value: Produto.where.not(categoria_id: nil).distinct.count(:categoria_id),
    description: "Categorias com produtos vinculados",
    icon: icon_svg("grid")
  }
] %>

<%= render layout: "layouts/admin" do %>
  <div class="space-y-6" data-controller="modal-loader">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Produtos</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Gerencie os itens cadastrados no sistema.</p>
      </div>

      <button type="button"
              data-modal-target="produto-modal-criar"
              data-modal-toggle="produto-modal-criar"
              class="inline-flex items-center justify-center rounded-lg bg-ruby-750 px-4 py-2.5 text-sm font-medium text-white hover:bg-ruby-800 focus:outline-none focus:ring-2 focus:ring-ruby-400">
        Novo produto
      </button>
    </div>

    <%= render "shared/admin/modal",
      modal_id: "produto-modal-criar",
      mode: :create,
      resource_name: "produto",
      subtitle: "Cadastre um novo produto sem sair da listagem." do %>
      <%= render "produtos/form",
        produto: (@novo_produto || Produto.new),
        categorias: @categorias,
        submit_label: "Criar produto",
        modal_id: "produto-modal-criar" %>
    <% end %>

    <%= render "shared/admin/modal",
      modal_id: "produto-modal-editar",
      mode: :edit,
      resource_name: "produto",
      subtitle: "Os dados são carregados dinamicamente ao clicar em editar." do %>
      <%= turbo_frame_tag "produto-modal-editar-frame" do %>
        <div class="rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4 text-sm text-gray-600 dark:border-gray-700 dark:bg-gray-800/60 dark:text-gray-300">
          Selecione um produto na tabela para carregar o formulário de edição.
        </div>
      <% end %>
    <% end %>

    <%= render "shared/admin/modal",
      modal_id: "produto-modal-visualizar",
      title: "Visualizar produto",
      subtitle: "Veja os detalhes do produto sem sair da listagem." do %>
      <%= turbo_frame_tag "produto-modal-visualizar-frame" do %>
        <div class="rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4 text-sm text-gray-600 dark:border-gray-700 dark:bg-gray-800/60 dark:text-gray-300">
          Selecione um produto na tabela para carregar os detalhes.
        </div>
      <% end %>
    <% end %>

    <%= render "shared/admin/summary_cards", cards: cards %>

    <%= render "shared/admin/data_table", 
      pagy: @pagy,
      records: @records,
      columns: columns,
      search_fields: [
        { value: "nome", label: "Nome" },
        { value: "categoria", label: "Categoria" }
      ],
      title: content_for(:title)
    %>
  </div>
<% end %>
