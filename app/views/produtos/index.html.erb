<% content_for :title, "Produtos" %>
<% columns = [
  { key: :nome, label: "Nome", sortable: true, row_header: true, width: "30%" },
  {
    key: :categoria,
    label: "Categoria",
    sortable: true,
    width: "18%",
    render: ->(record, _view) { record.categoria&.nome || record[:categoria].presence || "-" }
  },
  { key: :estoque, label: "Estoque", sortable: true, width: "12%" },
  {
    key: :preco,
    label: "Preço",
    sortable: true,
    width: "14%",
    render: ->(record, view) { view.number_to_currency(record.preco) }
  },
  {
    key: :status,
    label: "Status",
    width: "10%",
    render: ->(record, view) do
      badge_class = "ml-auto inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium"

      if record.disponivel?
        view.tag.span(
          "Disponível",
          class: "#{badge_class} bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-200"
        )
      elsif record.ativo?
        view.tag.span(
          "Sem estoque",
          class: "#{badge_class} bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-200"
        )
      else
        view.tag.span(
          "Inativo",
          class: "#{badge_class} bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200"
        )
      end
    end
  },
  {
    key: :actions,
    label: "Ações",
    width: "16%",
    actions: true,
    buttons: [
      {
        title: "Ver",
        href: ->(record) { polymorphic_path(record) },
        class: "rounded-lg border border-gray-300 px-3 py-2 text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800",
        icon: ->(view) do
          view.raw('<svg class="h-4 w-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1.5 12s3.75-7.5 10.5-7.5S22.5 12 22.5 12s-3.75 7.5-10.5 7.5S1.5 12 1.5 12Zm10.5 4.5a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Z"/></svg>')
        end
      },
      {
        title: "Editar",
        href: ->(record) { polymorphic_path([:edit, record]) },
        class: "rounded-lg bg-ruby-750 px-3 py-2 text-white hover:bg-ruby-800",
        icon: ->(view) do
          view.raw('<svg class="h-4 w-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m16.862 4.487 1.687-1.687a1.875 1.875 0 1 1 2.652 2.652L7.875 18.778a4.5 4.5 0 0 1-1.897 1.13L3 21l1.092-2.978a4.5 4.5 0 0 1 1.13-1.897l11.64-11.638ZM19.5 7.125 16.875 4.5"/></svg>')
        end
      }
    ]
  }
] %>

<% cards = [
  {
    title: "Total de produtos",
    value: Produto.count,
    description: "Quantidade de registros cadastrados",
    icon: icon_svg("box")
  },
  {
    title: "Produtos ativos",
    value: Produto.where(ativo: true).count,
    description: "Itens disponíveis no catálogo",
    icon: icon_svg("check")
  },
  {
    title: "Sem estoque",
    value: Produto.where(estoque: 0).count,
    description: "Produtos que precisam reposição",
    icon: icon_svg("alert")
  },
  {
    title: "Categorias usadas",
    value: Produto.where.not(categoria_id: nil).distinct.count(:categoria_id),
    description: "Categorias com produtos vinculados",
    icon: icon_svg("grid")
  }
] %>

<%= render layout: "layouts/admin" do %>
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Produtos</h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Gerencie os itens cadastrados no sistema.</p>
    </div>

    <%= render "shared/admin/summary_cards", cards: cards %>

    <%= render "shared/admin/data_table", 
      pagy: @pagy,
      records: @records,
      columns: columns,
      search_fields: [
        { value: "nome", label: "Nome" },
        { value: "categoria", label: "Categoria" }
      ],
      title: content_for(:title)
    %>
  </div>
<% end %>
