<% content_for :title, "Novo produto" %>

<%= render layout: "layouts/admin" do %>
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Novo produto</h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Cadastre um novo produto no sistema.</p>
    </div>

    <div class="rounded-2xl border border-gray-200 bg-gray-300 p-6 shadow-sm dark:border-gray-800 dark:bg-gray-900">
      <%= render "produtos/form", produto: @produto, categorias: @categorias, submit_label: "Criar produto" %>
    </div>
  </div>
<% end %>
