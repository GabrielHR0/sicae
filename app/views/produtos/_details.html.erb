<%
  status_class = if produto.disponivel?
    "bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-200"
  elsif produto.ativo?
    "bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-200"
  else
    "bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200"
  end

  status_label = if produto.disponivel?
    "Disponível"
  elsif produto.ativo?
    "Sem estoque"
  else
    "Inativo"
  end
%>

<div class="space-y-6">
  <div class="admin-form-panel-primary">
    <div class="flex flex-col gap-4 border-b border-gray-200 pb-5 dark:border-gray-800 md:flex-row md:items-start md:justify-between">
      <div class="space-y-2">
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-full bg-gradient-to-br from-gray-600/20 to-gray-800/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-gray-800 dark:bg-gradient-to-br from-gray-900/50 to-gray-950/50 dark:text-gray-200">
            Visualização do produto
          </span>
          <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium <%= status_class %>"><%= status_label %></span>
        </div>

        <div>
          <h4 class="text-2xl font-semibold text-gray-900 dark:text-white"><%= produto.nome %></h4>
          <p class="mt-1 text-sm text-gray-700 dark:text-gray-300">
            <%= produto.descricao.presence || "Sem descrição cadastrada para este produto." %>
          </p>
        </div>
      </div>

      <div class="rounded-2xl border border-gray-200 bg-white px-4 py-3 shadow-sm dark:border-gray-800 dark:bg-gray-900">
        <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">Preço</p>
        <p class="mt-1 text-2xl font-semibold text-gray-900 dark:text-white"><%= number_to_currency(produto.preco_atual) %></p>
      </div>
    </div>

    <div class="grid gap-4 pt-5 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-800 dark:bg-gray-900">
        <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">Código</p>
        <p class="mt-2 text-sm font-medium text-gray-900 dark:text-white"><%= produto.codigo.presence || "-" %></p>
      </div>

      <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-800 dark:bg-gray-900">
        <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">Categoria</p>
        <p class="mt-2 text-sm font-medium text-gray-900 dark:text-white"><%= produto.categoria&.nome || "-" %></p>
      </div>

      <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-800 dark:bg-gray-900">
        <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">Estoque</p>
        <p class="mt-2 text-sm font-medium text-gray-900 dark:text-white"><%= produto.estoque %> unidades</p>
      </div>

      <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-800 dark:bg-gray-900">
        <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">Situação</p>
        <p class="mt-2 text-sm font-medium text-gray-900 dark:text-white">
          <%= produto.ativo? ? "Ativo" : "Inativo" %>
        </p>
      </div>
    </div>
  </div>

  <div class="admin-form-panel-secondary">
    <div class="mb-5 border-b border-gray-200 pb-4 dark:border-gray-800">
      <p class="text-sm font-semibold uppercase tracking-wide text-gray-800 dark:text-white">Descrição detalhada</p>
      <p class="mt-1 text-sm text-gray-700 dark:text-gray-300">Informações complementares sobre o produto.</p>
    </div>

    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-gray-900">
      <p class="text-sm leading-6 text-gray-700 dark:text-gray-300">
        <%= produto.descricao.presence || "Sem descrição cadastrada." %>
      </p>
    </div>
  </div>

  <div class="flex flex-col-reverse gap-3 border-t border-gray-200 pt-4 sm:flex-row sm:items-center sm:justify-end dark:border-gray-700">
    <button type="button"
            data-action="click->modal-loader#close"
            class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800">
      Fechar
    </button>

    <%= link_to polymorphic_path(produto, modal: "edit"),
        title: "Editar",
        aria: { label: "Editar" },
        class: "inline-flex items-center justify-center rounded-lg bg-ruby-700 px-4 py-2 text-sm font-medium text-white hover:bg-ruby-800",
        data: {
          action: "click->modal-loader#open",
          modal_loader_modal_id: "produto-modal-editar",
          turbo_frame: "produto-modal-editar-frame"
        } do %>
      Editar
    <% end %>
  </div>
</div>
