<!doctype html>
<html lang="pt-BR" class="antialiased">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Admin • <%= content_for?(:title) ? yield(:title) : "Painel" %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body class="bg-gray-100 dark:bg-gray-1000 text-gray-900 dark:text-gray-100">
  <div class="min-h-screen flex">
    <aside id="sidebar" class="w-64 bg-ruby-750 dark:bg-neutral-950 border-r border-ruby-800 dark:border-gray-800">
      <%= render 'shared/admin/side_bar' %>
    </aside>

    <div class="flex-1 flex flex-col">
      <header class="bg-ruby-750 dark:bg-neutral-950 border-b border-ruby-800 dark:border-gray-800">
        <%= render 'shared/admin/topbar' %>
      </header>

      <main class="p-6 bg-gray-100 dark:bg-gray-1000">
        <%= render 'shared/admin/admin_breadcrumbs' rescue nil %>
        <div class="space-y-6">
          <%= yield %>
        </div>
      </main>
    </div>
  </div>
</body>
</html>