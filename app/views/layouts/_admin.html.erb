<!doctype html>
<html lang="pt-BR" class="antialiased dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Admin • <%= content_for?(:title) ? yield(:title) : "Painel" %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body class="admin-body bg-gray-100 dark:bg-gray-1000 text-gray-900 dark:text-gray-100">
  <div class="min-h-screen flex">
    <aside id="sidebar" class="w-64 bg-red-800 dark:bg-neutral-950 border-r border-red-800 dark:border-gray-800">
      <%= render 'shared/admin/side_bar' %>
    </aside>

    <div class="flex-1 flex flex-col">
      <header class="bg-red-800 dark:bg-neutral-950 border-b border-red-800 dark:border-gray-800">
        <%= render 'shared/admin/topbar' %>
      </header>

      <main class="p-6 bg-gray-100 dark:bg-gray-1000">
        <%= render 'shared/admin/admin_breadcrumbs' rescue nil %>
        <div class="space-y-6">
          <%= yield %>
        </div>
      </main>
    </div>
  </div>

  <script>
    (function(){
      function setIcons(isDark){
        const lightIcon = document.getElementById('theme-toggle-light');
        const darkIcon = document.getElementById('theme-toggle-dark');
        if(!lightIcon || !darkIcon) return;
        if(isDark){ darkIcon.classList.remove('hidden'); lightIcon.classList.add('hidden'); }
        else { lightIcon.classList.remove('hidden'); darkIcon.classList.add('hidden'); }
      }

      function applyTheme(theme){
        if(theme === 'dark') document.documentElement.classList.add('dark');
        else document.documentElement.classList.remove('dark');
        setIcons(theme === 'dark');
      }

      const stored = localStorage.getItem('theme');
      if(stored === 'light'){
        applyTheme('light');
      } else {
        applyTheme('dark');
      }
    })();
  </script>
</body>
</html>