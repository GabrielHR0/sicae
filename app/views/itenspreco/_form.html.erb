<%= form_with(model: item_preco, class: "contents") do |form| %>
  <% if item_preco.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(item_preco.errors.count, "error") %> prohibited this item_preco from being saved:</h2>

      <ul class="list-disc ml-6">
        <% item_preco.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :tabela_preco_id %>
    <%= form.text_field :tabela_preco_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": item_preco.errors[:tabela_preco_id].none?, "border-red-400 focus:outline-red-600": item_preco.errors[:tabela_preco_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :produto_id %>
    <%= form.text_field :produto_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": item_preco.errors[:produto_id].none?, "border-red-400 focus:outline-red-600": item_preco.errors[:produto_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :preco %>
    <%= form.text_field :preco, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": item_preco.errors[:preco].none?, "border-red-400 focus:outline-red-600": item_preco.errors[:preco].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
