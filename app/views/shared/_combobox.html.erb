<div data-controller="combobox"
     data-combobox-url-value="<%= url %>"
     data-combobox-display-value='<%= local_assigns[:display] || "${nome}" %>'
     data-combobox-text-field-value="<%= local_assigns[:text_field] || "nome" %>"
     class="relative">

  <% if local_assigns[:titulo] %>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
      <%= titulo %>
    </label>
  <% end %>

  <div class="relative">
    <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
      <svg class="w-4 h-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z"/>
      </svg>
    </div>
    <input type="text"
           data-combobox-target="input"
           data-action="input->combobox#search"
           placeholder="<%= local_assigns[:placeholder] || "Buscar..." %>"
           class="w-full border border-gray-300 dark:border-gray-600 rounded-lg py-2.5 pl-10 pr-10 text-sm shadow-sm
                  bg-gray-50 dark:bg-gray-800
                  text-gray-900 dark:text-gray-100
                  placeholder:text-gray-400 dark:placeholder:text-gray-500
                  focus:border-ruby-500 focus:ring-2 focus:ring-ruby-500/20
                  transition duration-150">

    <button type="button"
            data-action="combobox#limpar"
            class="absolute inset-y-0 right-0 flex items-center pr-3
                   text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <ul data-combobox-target="results"
      class="absolute z-10 mt-1 w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700
             rounded-lg shadow-lg hidden
             divide-y divide-gray-100 dark:divide-gray-700 max-h-60 overflow-auto">
  </ul>
</div>
