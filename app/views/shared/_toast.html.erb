<% if flash.any? %>
  <div class="fixed top-4 right-4 z-50 space-y-3">
    <% flash.each_with_index do |(type, message), index| %>
      <% style = case type.to_sym
        when :notice then { icon_bg: "bg-green-100 text-green-500 dark:bg-green-800 dark:text-green-200", ring: "text-green-500 dark:text-green-200" }
        when :alert, :error then { icon_bg: "bg-red-100 text-red-500 dark:bg-red-800 dark:text-red-200", ring: "text-red-500 dark:text-red-200" }
        when :warning then { icon_bg: "bg-yellow-100 text-yellow-500 dark:bg-yellow-800 dark:text-yellow-200", ring: "text-yellow-500 dark:text-yellow-200" }
        else { icon_bg: "bg-blue-100 text-blue-500 dark:bg-blue-800 dark:text-blue-200", ring: "text-blue-500 dark:text-blue-200" }
      end %>

      <div id="toast-<%= index %>" class="flex w-full max-w-xs items-center rounded-lg bg-white p-4 text-gray-500 shadow dark:bg-gray-800 dark:text-gray-400" role="alert" data-controller="toast">
        <div class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg <%= style[:icon_bg] %>">
          <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="sr-only"><%= type.to_s.humanize %></span>
        </div>
        <div class="ml-3 text-sm font-normal">
          <% Array(message).each do |m| %>
            <div><%= m %></div>
          <% end %>
        </div>
        <button type="button" class="ml-auto inline-flex h-8 w-8 items-center justify-center rounded-lg bg-white text-gray-400 hover:text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-300 dark:bg-gray-800 dark:text-gray-500 dark:hover:text-white dark:hover:bg-gray-700" data-action="toast#close" aria-label="Fechar">
          <span class="sr-only">Fechar</span>
          <svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1l12 12M13 1L1 13" />
          </svg>
        </button>
      </div>
    <% end %>
  </div>
<% end %>
