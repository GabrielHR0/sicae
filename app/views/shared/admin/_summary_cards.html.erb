<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <% cards.each do |card| %>
        <div class="rounded-xl border border-ruby-600/30 bg-gradient-to-br from-ruby-500 to-rose-600 p-5 shadow-sm text-white dark:border-ruby-700/30 dark:bg-gradient-to-br dark:from-ruby-600 dark:to-rose-700">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <p class="text-sm font-medium text-white dark:text-white">
                        <%= card[:title] %>
                    </p>
                    <p class="mt-2 text-3xl font-semibold tracking-tight text-white dark:text-white">
                        <%= card[:value] %>
                    </p>
                    <% if card[:description].present? %>
                        <p class="mt-2 text-sm text-ruby-100 dark:text-ruby-100">
                        <%= card[:description] %>
                        </p>
                    <% end %>
                </div>

                <% if card[:icon].present? %>
                    <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-white/20 text-white dark:bg-white/10">
                        <%= card[:icon] %>
                    </div>
                <% end %>
            </div>
            
            <% if card[:action].present? %>
                <div class="mt-4">
                <%= card[:action] %>
                </div>
            <% end %>
        </div>
    <% end %>
</div>