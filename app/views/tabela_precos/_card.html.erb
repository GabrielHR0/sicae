<div id="<%= dom_id tabela_preco %>" class="group relative bg-white dark:bg-neutral-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 hover:shadow-lg hover:-translate-y-1 transition-all duration-200 overflow-hidden">
  <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-ruby-500 to-ruby-700"></div>

  <div class="p-6 pb-5 pt-8">
    <div class="flex items-center gap-3">
      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400 ring-1 ring-gray-200 dark:ring-gray-700">
        <%= icon_svg case tabela_preco.tipo when "base" then :price_list when "personalizada" then :document else :tag end, classes: "h-5 w-5" %>
      </div>

      <div class="flex-1 min-w-0">
        <a href="#" class="block">
          <h5 class="text-base font-semibold text-gray-900 dark:text-gray-50 truncate group-hover:text-ruby-600 dark:group-hover:text-ruby-400 transition-colors">
            <%= tabela_preco.nome %>
          </h5>
        </a>
      </div>

      <span class="shrink-0 inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-xs font-medium
        <%= tabela_preco.ativo? ? 'bg-green-50 text-green-700 dark:bg-green-950/40 dark:text-green-400 ring-1 ring-green-200 dark:ring-green-800' : 'bg-gray-50 text-gray-500 dark:bg-gray-800 dark:text-gray-400 ring-1 ring-gray-200 dark:ring-gray-700' %>">
        <span class="w-1.5 h-1.5 rounded-full <%= tabela_preco.ativo? ? 'bg-green-500' : 'bg-gray-400' %>"></span>
        <%= tabela_preco.status.capitalize %>
      </span>
    </div>

    <p class="mt-4 text-sm text-gray-500 dark:text-gray-400 line-clamp-3">
      <%= tabela_preco.descricao %>
    </p>

    <div class="mt-5 flex items-center gap-4 text-xs text-gray-400 dark:text-gray-500">
        <% if tabela_preco.inicioVigencia && tabela_preco.fimVigencia%>
          <span class="inline-flex items-center gap-1">
              <svg class="w-3.5 h-3.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <%= l(tabela_preco.inicioVigencia, format: :short) %>
          </span>
          <span class="inline-flex items-center gap-1">
              <svg class="w-3.5 h-3.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <%= l(tabela_preco.fimVigencia, format: :short) %>
          </span>
        <% else %>
          <span class="inline-flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <circle cx="12" cy="12" r="9" />
              <path d="M12 7v5l3 3" />
            </svg>
            Tabela Permanente
          </span>
        <% end %>
      <span class="inline-flex items-center gap-1">
        <svg class="w-3.5 h-3.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
        <%= pluralize(tabela_preco.item_precos.count, "item") %>
      </span>
    </div>

    <hr class="my-5 border-gray-100 dark:border-gray-800">

    <div class="flex gap-2">
      <a href="<%= tabela_preco_item_precos_path(tabela_preco) %>" class="inline-flex flex-1 items-center justify-center gap-2 rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-neutral-800 px-4 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-ruby-50 hover:text-ruby-600 hover:border-ruby-200 dark:hover:bg-ruby-950/30 dark:hover:text-ruby-400 dark:hover:border-ruby-800 focus:outline-none focus:ring-2 focus:ring-ruby-200 dark:focus:ring-ruby-800 transition-colors">
        Ver Itens
        <svg class="inline w-4 h-4 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
      <a href="<%= tabela_preco_path(tabela_preco, modal: 'edit') %>"
         class="inline-flex flex-1 items-center justify-center gap-2 rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-neutral-800 px-4 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-ruby-50 hover:text-ruby-600 hover:border-ruby-200 dark:hover:bg-ruby-950/30 dark:hover:text-ruby-400 dark:hover:border-ruby-800 focus:outline-none focus:ring-2 focus:ring-ruby-200 dark:focus:ring-ruby-800 transition-colors"
         data-action="click->modal-loader#open"
         data-modal-loader-modal-id="tabela-preco-modal-editar"
         data-turbo-frame="tabela-preco-modal-editar-frame">
        Editar
        <svg class="inline w-4 h-4 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </div>
</div>



