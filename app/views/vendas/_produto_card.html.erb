<div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-900">

  <div class="flex gap-6">
    <div class="flex h-auto w-28 shrink-0 items-center justify-center rounded-2xl border border-gray-200 bg-gray-100 dark:border-gray-700 dark:bg-gray-800">
      <svg class="h-14 w-14 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
      </svg>
    </div>

    <div class="flex flex-1 flex-col justify-center">
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-md bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-600 dark:bg-gray-800 dark:text-gray-300">
          <%= produto.codigo %>
        </span>
        <span class="rounded-md bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-600 dark:bg-gray-800 dark:text-gray-300">
          <%= produto.categoria&.nome || "—" %>
        </span>
      </div>

      <h3 class="mt-3 text-2xl font-bold text-gray-900 dark:text-white leading-tight">
        <%= produto.nome %>
      </h3>

      <div class="mt-2">
        <p class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">Detalhes</p>
        <% if produto.descricao.present? %>
          <p class="mt-1 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
            <%= produto.descricao %>
          </p>
        <% else %>
          <p class="mt-1 text-sm text-gray-400 dark:text-gray-500 italic">Nenhum detalhe adicional.</p>
        <% end %>
      </div>
    </div>

    <div class="flex shrink-0 flex-col items-center justify-center">
      <div class="rounded-xl border border-gray-200 bg-gray-50 px-5 py-4 text-center dark:border-gray-700 dark:bg-gray-800/50">
        <span class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">Preço unitário</span>
        <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white tabular-nums">
          <%= number_to_currency(produto.preco) %>
        </p>
      </div>
    </div>
  </div>

  <div class="mt-6 flex items-end gap-4 rounded-xl border border-gray-200 bg-gray-50 px-5 py-4 dark:border-gray-700 dark:bg-gray-800/50">
    <div class="flex items-center gap-3 shrink-0">
      <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Qtd</span>
      <div class="flex items-center gap-1">
        <button type="button"
                data-action="click->vendas#decrementarQtd"
                class="flex h-10 w-10 items-center justify-center rounded-lg border border-gray-300 bg-white text-base font-medium text-gray-600 hover:bg-gray-100 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700">
          −
        </button>
        <input type="number" value="1" min="1"
               class="h-10 w-16 rounded-lg border border-gray-300 bg-white text-center text-sm font-semibold text-gray-900 focus:border-ruby-500 focus:ring-2 focus:ring-ruby-500/20 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100">
        <button type="button"
                data-action="click->vendas#incrementarQtd"
                class="flex h-10 w-10 items-center justify-center rounded-lg border border-gray-300 bg-white text-base font-medium text-gray-600 hover:bg-gray-100 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700">
          +
        </button>
      </div>
    </div>

    <div class="flex-1 border-t-2 border-dashed border-gray-300 dark:border-gray-600"></div>

    <div class="text-right shrink-0">
      <span class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">Subtotal</span>
      <p class="mt-0.5 text-xl font-bold text-gray-900 dark:text-white tabular-nums" id="subtotal-item">
        <%= number_to_currency(produto.preco) %>
      </p>
    </div>
  </div>

  <div class="mt-6 flex items-center gap-3">
    <button type="button"
            data-action="click->vendas#cancelaSelecao"
            class="flex-1 rounded-xl border border-gray-300 px-4 py-4 text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-800">
      Cancelar
    </button>
    <button type="button"
            data-action="click->vendas#adicionaAoCarrinho"
            class="flex-1 rounded-xl bg-ruby-600 px-4 py-4 text-sm font-semibold text-white shadow-sm hover:bg-ruby-700">
      Adicionar ao carrinho
    </button>
  </div>
</div>
