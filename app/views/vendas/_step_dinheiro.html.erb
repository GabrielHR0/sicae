<div data-pagamento-stepper-target="step" data-step="1" class="hidden space-y-5">
  <h4 class="text-center text-sm font-semibold text-gray-900 dark:text-gray-100">
    Pagamento em Dinheiro
  </h4>

  <div class="rounded-xl border border-gray-200 bg-gray-50 p-4 text-center dark:border-gray-700 dark:bg-gray-800/50">
    <span class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">Total a pagar</span>
    <p class="mt-1 text-3xl font-bold text-gray-900 dark:text-white tabular-nums" data-pagamento-stepper-target="totalExibir">
      R$ 0,00
    </p>
  </div>

  <div class="space-y-3">
    <div>
      <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">Valor recebido</label>
      <div class="relative">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm font-semibold text-gray-500 dark:text-gray-400">R$</span>
        <input type="text" inputmode="decimal"
               data-pagamento-stepper-target="valorRecebido"
               data-action="input->pagamento-stepper#calcularTroco"
               placeholder="0,00"
               class="w-full rounded-xl border border-gray-300 bg-white py-3 pl-10 pr-4 text-right text-2xl font-bold text-gray-900 tabular-nums placeholder:text-gray-300 focus:border-ruby-500 focus:ring-2 focus:ring-ruby-500/20 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100 dark:placeholder:text-gray-600">
      </div>
    </div>

    <div class="flex items-center justify-between rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-gray-700 dark:bg-gray-800/50">
      <span class="text-sm font-medium text-gray-600 dark:text-gray-400">Troco</span>
      <span class="text-xl font-bold text-emerald-600 dark:text-emerald-400 tabular-nums" data-pagamento-stepper-target="trocoExibir">
        R$ 0,00
      </span>
    </div>
  </div>

  <div class="flex items-center gap-3 pt-1">
    <button type="button"
            data-action="click->pagamento-stepper#voltar"
            class="flex-1 rounded-xl border border-gray-300 px-4 py-3 text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-800">
      Voltar
    </button>
    <button type="button"
            data-action="click->pagamento-stepper#confirmar"
            class="flex-1 rounded-xl bg-ruby-600 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-ruby-700 focus:outline-none focus:ring-2 focus:ring-ruby-500/30">
      Confirmar Pagamento
    </button>
  </div>
</div>
