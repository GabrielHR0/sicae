<header class="antialiased border-b border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900">
  <nav class="w-full px-4 py-3">
    <div class="flex items-center justify-between gap-4">

      <div class="flex items-center gap-3">
        <img src="/logo.png" class="h-7 sm:h-8" alt="Sicae Logo">
        <span class="whitespace-nowrap text-xl font-semibold text-gray-900 dark:text-white">SICAE</span>
        <% if Current.escola %>
          <span class="hidden sm:inline text-sm text-gray-500 dark:text-gray-400 ml-2 pl-3 border-l border-gray-300 dark:border-gray-600">
            <%= Current.escola.nome %>
          </span>
        <% end %>
      </div>

      <div class="flex items-center gap-3">

        <div>
          <%= render "shared/combobox",
              placeholder: "Digite a matrícula do estudante",
              url: "/estudantes/busca",
              display: '<span class="text-gray-800 dark:text-gray-200 font-medium">${matricula} — ${nome}</span>',
              text_field: "nome"
          %>
        </div>

        <button id="theme-toggle" aria-label="Alternar tema" class="rounded-lg bg-gray-100 p-2 text-gray-700 hover:bg-gray-200 focus:ring-2 focus:ring-gray-200 dark:bg-gray-800 dark:text-white dark:hover:bg-gray-700 dark:focus:ring-gray-500">
          <svg id="theme-toggle-light" xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
          <svg id="theme-toggle-dark" xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
        </button>

        <div class="flex items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-3 py-1.5 dark:border-gray-700 dark:bg-gray-800">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-ruby-500 to-rose-600 text-white">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </span>
          <span class="hidden lg:inline text-sm font-medium text-gray-900 dark:text-white">
            <%= current_user.perfil&.nome || current_user.username || current_user.email %>
          </span>
        </div>
      </div>

    </div>
  </nav>
</header>
