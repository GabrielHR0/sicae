<div data-pagamento-stepper-target="step" data-step="0" class="space-y-4">
  <button type="button"
          data-action="click->pagamento-stepper#cancelar"
          class="absolute right-4 top-4 rounded-lg p-1 text-gray-400 hover:bg-gray-100 hover:text-gray-600 dark:hover:bg-gray-800 dark:hover:text-gray-300">
    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 18 6M6 6l12 12"/>
    </svg>
  </button>

  <h4 class="text-center text-sm font-semibold text-gray-900 dark:text-gray-100">
    Selecione a forma de pagamento
  </h4>

  <div class="flex flex-col items-center gap-3">
    <button type="button"
            data-action="click->pagamento-stepper#selecionarForma"
            data-forma="dinheiro"
            class="w-64 rounded-xl border border-gray-200 bg-gray-50 px-6 py-4 text-center text-sm font-medium text-gray-700 shadow-sm transition-all hover:border-ruby-300 hover:bg-ruby-50 hover:text-ruby-700 focus:outline-none focus:ring-2 focus:ring-ruby-500/30 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-300 dark:hover:border-ruby-500 dark:hover:bg-ruby-900/20 dark:hover:text-ruby-300">
      <span class="block text-base font-semibold">Dinheiro</span>
      <span class="mt-0.5 block text-xs text-gray-500 dark:text-gray-400">Pagar na hora com dinheiro</span>
    </button>

    <button type="button"
            disabled
            title="Em breve"
            class="w-64 rounded-xl border border-gray-200 bg-gray-50 px-6 py-4 text-center text-sm font-medium text-gray-400 shadow-sm cursor-not-allowed dark:border-gray-600 dark:bg-gray-800 dark:text-gray-500">
      <span class="block text-base font-semibold">Fatura</span>
      <span class="mt-0.5 block text-xs text-gray-500 dark:text-gray-400">Lançar na fatura do responsável</span>
    </button>
  </div>

  <div class="pt-2">
    <button type="button"
            data-action="click->pagamento-stepper#cancelar"
            class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm font-semibold text-gray-600 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-400 dark:hover:bg-gray-800">
      Cancelar venda
    </button>
  </div>
</div>
