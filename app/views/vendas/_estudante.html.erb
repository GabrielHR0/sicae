<div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-700 dark:bg-gray-900">
  <div class="flex items-start gap-6">
    <div class="flex shrink-0 flex-col items-center">
      <div class="flex h-14 w-14 items-center justify-center rounded-xl border border-gray-200 bg-gray-100 dark:border-gray-700 dark:bg-gray-800">
        <svg class="h-7 w-7 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
      </div>
      <button type="button"
              data-action="click->vendas#limparEstudante"
              class="mt-2 text-xs font-medium text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-300">
        Remover
      </button>
    </div>

    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="rounded-md bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-600 dark:bg-gray-800 dark:text-gray-300">
          <%= estudante.matricula.presence || "—" %>
        </span>
        <span class="rounded-md bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-600 dark:bg-gray-800 dark:text-gray-300">
          <%= estudante.turma.presence || "—" %>
        </span>
        <span class="rounded-md bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-600 dark:bg-gray-800 dark:text-gray-300">
          <%= estudante.serie.presence || "—" %>
        </span>
      </div>
      <h3 class="mt-2 text-2xl font-bold text-gray-900 dark:text-white leading-tight truncate">
        <%= estudante.nome %>
      </h3>

      <div class="mt-6">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-2">
          Últimas reservas
        </h4>
        <% reservas = estudante.reservas.order(data: :desc).limit(5) %>
        <% if reservas.any? %>
          <div class="space-y-2">
            <% reservas.each do |r| %>
              <div class="flex items-center justify-between rounded-lg border border-gray-100 bg-gray-50 px-3 py-2 text-xs dark:border-gray-700 dark:bg-gray-800/50">
                <span class="font-medium text-gray-900 dark:text-white"><%= r.produto&.nome || "—" %></span>
                <span class="text-gray-500 dark:text-gray-400"><%= r.data.strftime("%d/%m/%Y") %></span>
                <div class="flex gap-1 shrink-0">
                  <button type="button"
                          data-action="click->vendas#adicionarReserva"
                          data-produto-id="<%= r.produto_id %>"
                          data-produto-nome="<%= r.produto&.nome %>"
                          data-produto-preco="<%= r.produto&.preco_atual %>"
                          data-produto-codigo="<%= r.produto&.codigo %>"
                          class="rounded-md bg-gray-200 px-2 py-1 text-xs font-medium text-gray-700 hover:bg-gray-300 dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600">
                    Add
                  </button>
                  <button type="button"
                          data-action="click->vendas#pagarReserva"
                          data-produto-id="<%= r.produto_id %>"
                          data-produto-nome="<%= r.produto&.nome %>"
                          data-produto-preco="<%= r.produto&.preco_atual %>"
                          data-produto-codigo="<%= r.produto&.codigo %>"
                          class="rounded-md bg-ruby-600 px-2 py-1 text-xs font-medium text-white hover:bg-ruby-700 dark:bg-ruby-700 dark:hover:bg-ruby-600">
                    Pagar
                  </button>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-xs text-gray-400 dark:text-gray-500 italic">Nenhuma reserva encontrada.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

