<% content_for :title, "Editar estudante" %>

<%= render layout: "layouts/admin" do %>
  <div class="space-y-6" data-controller="modal-loader">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Editar estudante</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Atualize os dados do estudante.</p>
      </div>
    </div>

    <%= turbo_frame_tag "estudante-modal-editar-frame" do %>
      <%= render "estudantes/form", estudante: @estudante, responsaveis: @responsaveis || [], modal_id: "estudante-modal-editar" %>
    <% end %>
  </div>
<% end %>