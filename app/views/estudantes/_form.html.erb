<%
  estudante = local_assigns[:estudante]
  submit_label = local_assigns[:submit_label].presence || (estudante&.persisted? ? "Salvar alterações" : "Cadastrar estudante")
  modal_id = local_assigns[:modal_id]
  responsaveis = local_assigns[:responsaveis] || []
%>

<%= form_with model: estudante,
              class: "space-y-6",
              data: (
                modal_id.present? ? {
                  controller: "modal-form",
                  action: "turbo:submit-start->modal-form#start turbo:submit-end->modal-form#end"
                } : {}
              ) do |form| %>
  <% if estudante.errors.any? %>
    <div class="rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-800 shadow-sm dark:border-red-900/40 dark:bg-red-950/35 dark:text-red-200">
      <p class="font-semibold"><%= pluralize(estudante.errors.count, "erro") %> impediram o salvamento</p>
      <ul class="mt-3 list-disc space-y-1 ps-5">
        <% estudante.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="admin-form-panel-primary">
    <div class="mb-5 flex items-center justify-between gap-3 border-b border-gray-200 pb-4 dark:border-gray-800">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-gray-800 dark:text-white">Informações do estudante</p>
        <p class="mt-1 text-sm text-gray-700 dark:text-gray-300">Dados cadastrais e escolares.</p>
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <div class="md:col-span-2">
        <%= form.label :nome, "Nome completo", class: "mb-2.5 block text-sm font-medium text-gray-800 dark:text-gray-100" %>
        <%= form.text_field :nome,
                required: true,
                placeholder: "Ex.: João da Silva",
                class: "admin-form-input" %>
      </div>

      <div>
        <%= form.label :matricula, "Matrícula", class: "mb-2.5 block text-sm font-medium text-gray-800 dark:text-gray-100" %>
        <%= form.text_field :matricula,
                placeholder: "Ex.: 2026001",
                class: "admin-form-input" %>
      </div>

      <div>
        <%= form.label :data_nascimento, "Data de nascimento", class: "mb-2.5 block text-sm font-medium text-gray-800 dark:text-gray-100" %>
        <%= form.date_field :data_nascimento, class: "admin-form-input" %>
      </div>

      <div>
        <%= form.label :serie, "Série", class: "mb-2.5 block text-sm font-medium text-gray-800 dark:text-gray-100" %>
        <%= form.number_field :serie,
                min: 1,
                max: 9,
                placeholder: "Ex.: 6",
                class: "admin-form-input" %>
      </div>

      <div>
        <%= form.label :turma, "Turma", class: "mb-2.5 block text-sm font-medium text-gray-800 dark:text-gray-100" %>
        <%= form.text_field :turma,
                placeholder: "Ex.: A",
                class: "admin-form-input" %>
      </div>

      <div>
        <%= form.label :nivel_escolaridade, "Nível de escolaridade", class: "mb-2.5 block text-sm font-medium text-gray-800 dark:text-gray-100" %>
        <%= form.select :nivel_escolaridade,
                options_for_select([
                  ["Selecione", nil],
                  ["Ensino Fundamental", 0],
                  ["Ensino Médio", 1]
                ], estudante.nivel_escolaridade),
                {},
                class: "admin-form-input" %>
      </div>

      <div class="md:col-span-2">
        <%= form.label :responsavel_id, "Responsável", class: "mb-2.5 block text-sm font-medium text-gray-800 dark:text-gray-100" %>
        <%= form.select :responsavel_id,
                options_for_select(
                  [["Selecione um responsável", nil]] + responsaveis,
                  estudante.responsavel_id
                ),
                {},
                class: "admin-form-input" %>
        <p class="mt-2 text-xs text-gray-700 dark:text-gray-400">Vincule o estudante a um responsável já cadastrado.</p>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3 border-t border-gray-200 pt-4 dark:border-gray-700">
    <% if modal_id.present? %>
      <button type="button"
              data-action="click->modal-loader#close"
              class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800">
        Cancelar
      </button>
    <% else %>
      <%= link_to "Cancelar", estudantes_path, class: "rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800" %>
    <% end %>

    <%= form.button type: :submit,
                    data: { modal_form_target: "submitButton" },
                    class: "inline-flex items-center justify-center gap-2 rounded-lg bg-ruby-700 px-4 py-2 text-sm font-medium text-white hover:bg-ruby-800" do %>
      <span data-modal-form-target="submitLabel"><%= submit_label %></span>
      <svg data-modal-form-target="submitSpinner" class="hidden h-4 w-4 animate-spin" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M12 2a10 10 0 1 0 10 10h-3a7 7 0 1 1-7-7V2Z"></path>
      </svg>
    <% end %>
  </div>
<% end %>
