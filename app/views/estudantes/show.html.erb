<% content_for :title, @estudante.nome %>

<%= render layout: "layouts/admin" do %>
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900 dark:text-white"><%= @estudante.nome %></h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        <%= link_to "← Voltar para estudantes", estudantes_path, class: "text-ruby-700 hover:underline dark:text-ruby-300" %>
      </p>
    </div>
    <%= link_to edit_estudante_path(@estudante, modal: "edit"),
        class: "inline-flex items-center justify-center rounded-lg bg-ruby-700 px-4 py-2.5 text-sm font-medium text-white hover:bg-ruby-800",
        data: {
          action: "click->modal-loader#open",
          modal_loader_modal_id: "estudante-modal-editar",
          turbo_frame: "estudante-modal-editar-frame"
        } do %>
      Editar
    <% end %>
  </div>

  <dl class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
    <div class="overflow-hidden rounded-xl border border-gray-200 bg-white px-4 py-5 dark:border-gray-700 dark:bg-gray-900 sm:p-6">
      <dt class="truncate text-sm font-medium text-gray-500 dark:text-gray-400">Bloqueios ativos</dt>
      <dd class="mt-1 text-2xl font-semibold text-rose-600 dark:text-rose-400"><%= @bloqueios.count %></dd>
    </div>
    <div class="overflow-hidden rounded-xl border border-gray-200 bg-white px-4 py-5 dark:border-gray-700 dark:bg-gray-900 sm:p-6">
      <dt class="truncate text-sm font-medium text-gray-500 dark:text-gray-400">Reservas</dt>
      <dd class="mt-1 text-2xl font-semibold text-gray-900 dark:text-white"><%= @reservas.count %></dd>
    </div>
  </dl>

  <div class="mt-8">
    <h2 class="text-base font-semibold text-gray-900 dark:text-white">Informações do aluno</h2>
    <div class="mt-4 rounded-xl border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-900">
      <dl class="grid grid-cols-1 sm:grid-cols-2">
        <div class="border-b border-r-0 border-gray-200 px-6 py-5 dark:border-gray-700 sm:border-r">
          <dt class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Nome</dt>
          <dd class="mt-1 text-sm text-gray-900 dark:text-white"><%= @estudante.nome %></dd>
        </div>
        <div class="border-b border-gray-200 px-6 py-5 dark:border-gray-700">
          <dt class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Matrícula</dt>
          <dd class="mt-1 text-sm text-gray-900 dark:text-white"><%= @estudante.matricula.presence || "-" %></dd>
        </div>
        <div class="border-b border-r-0 border-gray-200 px-6 py-5 dark:border-gray-700 sm:border-r">
          <dt class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Turma</dt>
          <dd class="mt-1 text-sm text-gray-900 dark:text-white"><%= @estudante.turma.presence || "-" %></dd>
        </div>
        <div class="border-b border-gray-200 px-6 py-5 dark:border-gray-700">
          <dt class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Série</dt>
          <dd class="mt-1 text-sm text-gray-900 dark:text-white"><%= @estudante.serie.presence || "-" %></dd>
        </div>
        <div class="border-b border-r-0 border-gray-200 px-6 py-5 dark:border-gray-700 sm:border-r">
          <dt class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Nível</dt>
          <dd class="mt-1 text-sm text-gray-900 dark:text-white">
            <% map = { 0 => "Ensino Fundamental", 1 => "Ensino Médio" } %>
            <%= map[@estudante.nivel_escolaridade] || "-" %>
          </dd>
        </div>
        <div class="border-b border-gray-200 px-6 py-5 dark:border-gray-700">
          <dt class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Nascimento</dt>
          <dd class="mt-1 text-sm text-gray-900 dark:text-white"><%= @estudante.data_nascimento&.strftime("%d/%m/%Y") || "-" %></dd>
        </div>
        <div class="border-b-0 border-r-0 border-gray-200 px-6 py-5 dark:border-gray-700 sm:border-r">
          <dt class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Responsável</dt>
          <dd class="mt-1 text-sm">
            <% if @estudante.responsavel %>
              <%= link_to @estudante.responsavel.user&.perfil&.nome || "Ver",
                  responsavel_path(@estudante.responsavel),
                  class: "font-medium text-ruby-700 hover:text-ruby-600 dark:text-ruby-300" %>
            <% else %>
              <span class="text-gray-900 dark:text-white">-</span>
            <% end %>
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <div class="mt-8">
    <h2 class="text-base font-semibold text-gray-900 dark:text-white">Bloqueios ativos</h2>
    <div class="mt-4 overflow-hidden rounded-xl border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-900">
      <% if @bloqueios.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gray-50 dark:bg-gray-800">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Produto</th>
                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Tipo</th>
                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Início</th>
                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Fim</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
              <% @bloqueios.each do |b| %>
                <tr class="hover:bg-gray-50 dark:hover:bg-gray-800">
                  <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900 dark:text-white"><%= b.produto&.nome || "-" %></td>
                  <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
                    <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-800 dark:bg-amber-950 dark:text-amber-200">
                      <%= b.tipo_periodo.humanize %>
                    </span>
                  </td>
                  <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500 dark:text-gray-400"><%= b.data_inicio.strftime("%d/%m/%Y") %></td>
                  <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500 dark:text-gray-400"><%= b.data_fim&.strftime("%d/%m/%Y") || "Indeterminado" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="px-6 py-8 text-center text-sm text-gray-500 dark:text-gray-400">Nenhum bloqueio ativo.</p>
      <% end %>
    </div>
  </div>

  <div class="mt-8">
    <h2 class="text-base font-semibold text-gray-900 dark:text-white">Últimas reservas</h2>
    <div class="mt-4 overflow-hidden rounded-xl border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-900">
      <% if @reservas.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gray-50 dark:bg-gray-800">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Produto</th>
                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Data</th>
                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Responsável</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
              <% @reservas.each do |r| %>
                <tr class="hover:bg-gray-50 dark:hover:bg-gray-800">
                  <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900 dark:text-white"><%= r.produto&.nome || "-" %></td>
                  <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500 dark:text-gray-400"><%= r.data.strftime("%d/%m/%Y") %></td>
                  <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500 dark:text-gray-400"><%= r.responsavel.user&.perfil&.nome || "-" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="px-6 py-8 text-center text-sm text-gray-500 dark:text-gray-400">Nenhuma reserva encontrada.</p>
      <% end %>
    </div>
  </div>
<% end %>