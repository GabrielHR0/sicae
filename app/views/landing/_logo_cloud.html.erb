<section class="py-12 sm:py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <div class="section-kicker">Confiado por escolas</div>
      <p class="mt-4 text-sm font-medium uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400">Instituições que já transformaram sua cantina com o SICAE</p>
    </div>
    <div class="ticker-mask mt-8 overflow-hidden">
      <div class="marquee flex w-max gap-4 pr-4">
        <% ["Colégio Aurora", "Escola Nova", "Instituto Saber", "Colégio Monteiro", "Escola Primeiro Passo", "Instituto Educar", "Colégio Bandeirantes", "Escola Futuro"].each do |nome| %>
          <div class="logo-chip flex min-w-[150px] items-center justify-center rounded-2xl px-6 py-4 text-sm font-semibold uppercase tracking-[0.22em] text-slate-600 dark:text-slate-300"><%= nome %></div>
        <% end %>
        <% ["Colégio Aurora", "Escola Nova", "Instituto Saber", "Colégio Monteiro", "Escola Primeiro Passo", "Instituto Educar", "Colégio Bandeirantes", "Escola Futuro"].each do |nome| %>
          <div class="logo-chip flex min-w-[150px] items-center justify-center rounded-2xl px-6 py-4 text-sm font-semibold uppercase tracking-[0.22em] text-slate-600 dark:text-slate-300"><%= nome %></div>
        <% end %>
      </div>
    </div>
  </div>
</section>
