<%= render "landing/header" %>
<main>
  <%= render "landing/hero" %>
  <%= render "landing/logo_cloud" %>
  <%= render "landing/stats" %>
  <%= render "landing/features" %>
  <%= render "landing/pricing" %>
  <%= render "landing/testimonials" %>
  <%= render "landing/faq" %>
  <%= render "landing/cta" %>
</main>
<div id="watch-demo" data-modal class="modal-backdrop fixed inset-0 z-[60] flex items-center justify-center bg-slate-950/70 px-4">
  <div class="modal-panel surface max-h-[90vh] w-full max-w-3xl overflow-hidden rounded-[2rem] p-6 sm:p-8">
    <div class="flex items-center justify-between gap-4">
      <div>
        <div class="section-kicker">Demonstração</div>
        <h3 class="mt-2 text-2xl font-bold text-slate-950 dark:text-white">Fluxo do SICAE</h3>
      </div>
      <button type="button" data-modal-close class="btn-secondary !p-3">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M6 18 18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div class="mt-6 grid gap-6 lg:grid-cols-[1.05fr_.95fr]">
      <div class="rounded-[1.75rem] bg-gradient-to-br from-red-500/20 via-orange-500/10 to-rose-500/20 p-4">
        <div class="grid-backdrop dashboard-screen rounded-[1.5rem] border border-white/20 bg-slate-950/90 p-6 text-white dark:bg-white/[0.04]">
          <div class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-400">Tour guiado</div>
          <div class="mt-4 text-3xl font-bold leading-tight">Veja como o SICAE transforma a gestão da sua cantina.</div>
        </div>
      </div>
      <div class="rounded-[1.75rem] border border-slate-200/70 bg-white/80 p-6 dark:border-white/10 dark:bg-white/[0.04]">
        <div class="text-lg font-bold text-slate-950 dark:text-white">O que você vai ver</div>
        <div class="mt-4">
          <ul class="space-y-3 text-sm text-slate-600 dark:text-slate-300">
            <li class="flex items-start gap-3">
              <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-emerald-500">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="m4.5 12.75 6 6 9-13.5"/></svg>
              </span>
              <span>Cardápio digital ao vivo</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-emerald-500">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="m4.5 12.75 6 6 9-13.5"/></svg>
              </span>
              <span>Gestão de estoque inteligente</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-emerald-500">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="m4.5 12.75 6 6 9-13.5"/></svg>
              </span>
              <span>Portal dos pais com controle de gastos</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-emerald-500">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="m4.5 12.75 6 6 9-13.5"/></svg>
              </span>
              <span>Múltiplas formas de pagamento</span>
            </li>
          </ul>
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/dashboard" class="btn-primary">Ir para o dashboard</a>
          <a href="#pricing" class="btn-secondary">Ver planos</a>
        </div>
      </div>
    </div>
  </div>
</div>
<%= render "landing/footer" %>
